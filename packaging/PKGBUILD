pkgname=mango-layout-tray
pkgver=0.1.4
pkgrel=1
pkgdesc='A visual layout picker for MangoWM in your system tray'
arch=('x86_64' 'aarch64')
url='https://github.com/mikkelrask/mango-layout-tray'
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell')
makedepends=('rust' 'git')
optdepends=('mangowm: Wayland compositor controlled by this app')
source=("$pkgname::git+https://github.com/mikkelrask/mango-layout-tray.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    cargo build --release --locked
}

check() {
    cd "$srcdir/$pkgname"
    cargo test --release --locked
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 target/release/mango-layout-tray "$pkgdir/usr/bin/mango-layout-tray"
    install -Dm644 data/mango-layout-tray.desktop "$pkgdir/usr/share/applications/mango-layout-tray.desktop"
    install -Dm644 data/mango-layout-tray.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/mango-layout-tray.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/mango-layout-tray/LICENSE"
}
